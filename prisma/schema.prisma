// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  // native = local Windows/Mac; rhel = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String?      @unique
  phone        String?      @unique
  role         Roles        @default(ADMIN)
  farmingMode  FarmingMode  @default(LIVESTOCK)
  password     String?
  status       Boolean      @default(true)

  users        User[]
  activityLogs ActivityLog[]
  veterinarian Veterinarian?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}

enum Roles {
  SUPERADMIN
  ADMIN
  MANAGER
  VETERINARIAN
}

enum FarmingMode {
  LIVESTOCK
  AGRICULTURE
  HYBRID
}

enum FarmCategory {
  LIVESTOCK
  AGRICULTURE
}

model User {
  id          String   @id @default(uuid())
  accountId   String   @unique
  fullname    String
  gender      Gender?
  profilePic  String?
  
  farms            Farm[]         @relation("UserFarms")
  managedFarmLinks FarmManager[]  @relation("FarmManagers")
  assignedTasks    FarmTask[]     @relation("TaskAssignee")

  account        Account     @relation(fields: [accountId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@index([accountId])
}

enum Gender {
  MALE
  FEMALE
}

model Farm {
  id          String       @id @default(uuid()) 
  name        String       @unique 
  location    String   
  size        Float    // Size of the farm in acres or hectares
  type        String   // Type of farm (e.g., crop, livestock, mixed)
  farmCategory FarmCategory @default(LIVESTOCK)
  ownerId     String?
  managerId   String?
  status      Boolean  @default(true)   

  registrationNo     String?
  description        String?
  yearEstablished    Int?
  grazingArea        Float?
  housingCapacity    Int?
  primaryLivestock   String?
  breeds             String?
  herdSizeEstimate   Int?
  primaryCrops       String?
  cultivatedArea     Float?
  irrigationType     String?
  soilType           String?
  fieldCountEstimate Int?
  contactPhone       String?
  contactEmail       String?
  emergencyContact   String?
  landmarks          String?
  latitude           String?
  longitude          String?
  waterSource        String?
  hasElectricity     Boolean  @default(false)
  veterinaryAccess   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  owner       User?    @relation("UserFarms", fields: [ownerId], references: [id])
  managerLinks FarmManager[]
  cattle      Cattle[] @relation("FarmToCattle")
  livestock   Livestock[] @relation("FarmToLivestock")

  productions Production[]
  wasteLogs   WastesLog[]
  productionTotals  ProductionTotals[]
  productionTransactions ProductionTransaction[]

  stocks      Stock[]
  transactions Transaction[]
  suppliers   Supplier[]
  vaccinations  Vaccination[]
  inseminations  Insemination[]
  veterinarians  Veterinarian[]
  milkingPeriods MilkingPeriod[]
  medicines      Medicine[]
  medicineUsages MedicineUsage[]

  cropTypes   CropType[]
  growFields  GrowField[]
  plantings   Planting[]
  farmTasks   FarmTask[]

  @@index([ownerId])
  @@index([farmCategory])
}

model FarmManager {
  id        String   @id @default(uuid())
  farmId    String
  userId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User     @relation("FarmManagers", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([farmId, userId])
  @@index([farmId])
  @@index([userId])
}



model Cattle {
  id               String       @id @default(uuid())
  tagNumber        String       @unique
  breed            String
  gender           String
  DOB              DateTime?
  weight           Float
  status           CattleStatus  @default(HEALTHY)
  location         String?
  farmId           String
  lastCheckupDate  DateTime?
  vaccineHistory   String?
  purchaseDate     DateTime?
  price            Float?
  motherTag        String?
  milkingStatus    MilkingStatus @default(INACTIVE)
  milkingStatusChangedAt DateTime @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  farm             Farm              @relation("FarmToCattle", fields: [farmId], references: [id])
  farmTasks        FarmTask[]

  productions      Production[]
  vaccinations  Vaccination[]
  inseminations  Insemination[]
  milkingPeriods MilkingPeriod[]
  medicineUsages MedicineUsage[]

  @@index([farmId])
}

enum CattleStatus {
  HEALTHY
  SICK
  SOLD
  PROCESSED
  DECEASED
}

/// Non-cattle farm animals: goats, sheep, pigs, poultry, rabbits.
/// One row per animal, so health and breeding records attach to an individual.
model Livestock {
  id               String            @id @default(uuid())
  tagNumber        String
  species          LivestockSpecies
  breed            String?
  gender           LivestockGender   @default(FEMALE)
  DOB              DateTime?
  weight           Float?
  status           LivestockStatus   @default(HEALTHY)
  location         String?
  farmId           String
  motherTag        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  farm             Farm              @relation("FarmToLivestock", fields: [farmId], references: [id], onDelete: Cascade)
  farmTasks        FarmTask[]
  vaccinations     Vaccination[]
  medicineUsages   MedicineUsage[]

  @@unique([farmId, tagNumber])
  @@index([farmId])
  @@index([farmId, species])
  @@index([farmId, status])
}

enum LivestockSpecies {
  GOAT
  SHEEP
  PIG
  POULTRY
  RABBIT
  OTHER
}

enum LivestockGender {
  MALE
  FEMALE
}

enum LivestockStatus {
  HEALTHY
  SICK
  SOLD
  PROCESSED
  DECEASED
}

enum MilkingStatus {
  ACTIVE
  INACTIVE
}

model MilkingPeriod {
  id        String   @id @default(uuid())
  cattleId  String
  farmId    String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cattle Cattle @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([cattleId, startedAt])
  @@index([farmId, startedAt])
  @@index([cattleId, endedAt])
}

enum MilkingSession {
  MORNING
  EVENING
}

model Production {
  id              String   @id @default(uuid())
  farmId          String
  cattleId        String
  productName     String
  quantity        Float
  /// Morning or evening milking; null for non-milk products
  milkingSession  MilkingSession?
  productionDate  DateTime
  expirationDate  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farm            Farm     @relation(fields: [farmId], references: [id])
  cattle          Cattle   @relation(fields: [cattleId], references: [id])

  @@index([farmId])
  @@index([cattleId])
  @@index([cattleId, productionDate, milkingSession])
}

model ProductionTransaction {
  id              String   @id @default(uuid())
  farmId          String
  productType     ProductType
  /// How production was used that day
  usageCategory   ProductionUsageCategory @default(SOLD_TO_DAIRY)
  /// Snapshot of that day's produced quantity (or stock) at sale time
  total           Float
  quantity        Float
  /// Unit price used for dairy sales (null for on-farm / umucunda use)
  unitPrice       Float?
  /// Expected sale amount (quantity × unitPrice) — 0 for non-sale usage
  value           Float
  /// Amount actually paid; null = treat as fully paid (legacy rows)
  amountPaid      Float?
  /// Production day this sale is deducted from
  date            DateTime  @default(now())
  /// Dairy name for SOLD_TO_DAIRY; label for other usages
  consumer        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farm            Farm     @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@index([farmId, productType, date])
  @@index([farmId, usageCategory])
}

model ProductionTotals {
  id           String      @id @default(uuid())
  farmId       String
  productType  ProductType
  totalQuantity  Float    @default(0.0)
  pricePerUnit  Float    @default(0.0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  farm         Farm        @relation(fields: [farmId], references: [id])

  @@unique([farmId, productType])
}

enum ProductType {
  MILK
  MEAT
  DUNG
  LIQUIDMANURE
}

enum ProductionUsageCategory {
  SOLD_TO_DAIRY
  USED_ON_FARM
  CONSUMED_BY_UMUCUNDA
}

model WastesLog {
  id              String   @id @default(uuid())
  farmId          String
  type            WasteType
  quantity        Int
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farm            Farm     @relation(fields: [farmId], references: [id])

  @@index([farmId])
}

enum WasteType {
  DUNG
  LIQUIDMANURE
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  status        String   @default("active")
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id])
  stocks        Stock[]
  transactions  Transaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([farmId])
}

model Stock {
  id                   String     @id @default(uuid())
  name                 String
  quantity             Int
  type                 StockType
  supplierId           String?
  supplier             Supplier?  @relation(fields: [supplierId], references: [id])
  unitOfMeasure        String     @default("piece")
  unitsPerBox          Int?
  itemType             String     @default("consumable")
  defaultPurchasePrice Float?
  reorderLevel         Int?
  status               String     @default("active")
  description          String?
  leadTimeDays         Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  farmId               String
  farm                 Farm       @relation(fields: [farmId], references: [id])

  transactions Transaction[]

  @@unique([farmId, name])
  @@index([farmId])
  @@index([supplierId])
}

enum StockType {
  FOOD
  MEDICATION
  CONSTRUCTION
  WATER
  FEED_ACCESSORIES
  HYGIENE_MATERIALS
}

model Transaction {
  id          String   @id @default(uuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id])
  quantity    Int
  type        TransactionType
  date        DateTime @default(now())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id])
  reference   String?
  reason      String?
  unitCost    Float?
  expiryDate  DateTime?
  expiryNote  String?
  status      String   @default("CONFIRMED")
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  performedBy String?

  @@index([stockId])
  @@index([farmId])
  @@index([supplierId])
}

enum TransactionType {
  ADDITION
  CONSUME
}

/// Exactly one of cattleId / livestockId is set, so a record can belong to a
/// cow or to a non-cattle animal (goat, sheep, pig, poultry, rabbit).
model Vaccination {
  id           String       @id @default(uuid())
  cattleId     String?
  livestockId  String?
  farmId       String?       @default(uuid())
  date         DateTime     @default(now())
  /// Product / vaccine name administered
  vaccineType  String
  /// Disease the cattle was vaccinated against
  diseaseName  String?
  price        Float?
  documentUrl  String?
  documentName String?
  vetId        String?
  veterinarian Veterinarian? @relation(fields: [vetId], references: [id])
  cattle          Cattle?   @relation(fields: [cattleId], references: [id])
  livestock       Livestock? @relation(fields: [livestockId], references: [id])
  farm        Farm?     @relation(fields: [farmId], references: [id])

  @@map("vaccinations")
  @@index([cattleId])
  @@index([livestockId])
  @@index([vetId])
  @@index([farmId])
}

model Veterinarian {
  id            String         @id @default(uuid())
  name          String
  farmId        String?
  phone         String
  email         String         @unique
  accountId     String?        @unique
  vaccinations  Vaccination[]
  inseminations Insemination[]
  farm          Farm?          @relation(fields: [farmId], references: [id])
  account       Account?       @relation(fields: [accountId], references: [id])

  @@map("veterinarians")
  @@index([farmId])
  @@index([accountId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  accountId   String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  details     String?
  createdAt   DateTime @default(now())

  account     Account  @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([userId])
  @@index([createdAt])
}

model Insemination {
  id           String       @id @default(uuid())
  cattleId     String
  farmId       String?       @default(uuid())
  date         DateTime     @default(now())
  method       String
  type         String
  vetId        String?
  veterinarian Veterinarian? @relation(fields: [vetId], references: [id])
  cattle          Cattle   @relation(fields: [cattleId], references: [id])
  farm        Farm?     @relation(fields: [farmId], references: [id])


  @@map("inseminations")
  @@index([cattleId])
  @@index([vetId])
  @@index([farmId])

}

enum MedicineUnit {
  GRAMS
  LITERS
  PIECES
}

enum MedicineItemType {
  MEDICINE
  TOOL
}

/// Medicine or medical tool purchased for the farm (inventory / expense)
model Medicine {
  id           String           @id @default(uuid())
  farmId       String
  name         String
  /// MEDICINE (drug) or TOOL (e.g. syringe, needle)
  itemType     MedicineItemType @default(MEDICINE)
  /// Disease this medicine is meant to cure (empty for tools)
  diseaseName  String           @default("")
  /// Remaining quantity on hand
  quantity     Float
  unit         MedicineUnit     @default(GRAMS)
  /// Purchase cost (farm expense)
  cost         Float
  purchaseDate DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  farm         Farm             @relation(fields: [farmId], references: [id])
  usages       MedicineUsage[]  @relation("UsageMedicine")
  toolUsages   MedicineUsage[]  @relation("UsageTool")

  @@map("medicines")
  @@index([farmId])
  @@index([farmId, name])
  @@index([farmId, itemType])
}

/// Medicine administered to cattle (optionally with a tool such as a syringe)
model MedicineUsage {
  id           String   @id @default(uuid())
  farmId       String
  medicineId   String
  /// Optional tool used to deliver the medicine (e.g. syringe)
  toolId       String?
  /// How many tool units were used (default 1 when toolId is set)
  toolQuantity Float?
  /// Exactly one of cattleId / livestockId is set.
  cattleId     String?
  livestockId  String?
  quantity     Float
  /// Disease being treated for this use
  diseaseName  String
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farm         Farm     @relation(fields: [farmId], references: [id])
  medicine     Medicine @relation("UsageMedicine", fields: [medicineId], references: [id])
  tool         Medicine? @relation("UsageTool", fields: [toolId], references: [id])
  cattle       Cattle?   @relation(fields: [cattleId], references: [id])
  livestock    Livestock? @relation(fields: [livestockId], references: [id])

  @@map("medicine_usages")
  @@index([farmId])
  @@index([medicineId])
  @@index([toolId])
  @@index([cattleId])
  @@index([livestockId])
}

model CropType {
  id              String   @id @default(uuid())
  farmId          String
  name            String
  category        String?
  daysToMaturity  Int?
  rowSpacing      Float?
  plantSpacing    Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plantings       Planting[]

  @@unique([farmId, name])
  @@index([farmId])
}

enum GrowFieldType {
  FIELD
  BED
  GREENHOUSE
  ORCHARD
  OTHER
}

model GrowField {
  id            String        @id @default(uuid())
  farmId        String
  name          String
  size          Float?
  unit          String        @default("hectares")
  fieldType     GrowFieldType @default(FIELD)
  locationNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plantings     Planting[]
  farmTasks     FarmTask[]

  @@unique([farmId, name])
  @@index([farmId])
}

enum PlantingStatus {
  PLANNED
  ACTIVE
  HARVESTED
  COMPLETE
}

model Planting {
  id                   String         @id @default(uuid())
  farmId               String
  cropTypeId           String
  fieldId              String
  plantedDate          DateTime
  expectedHarvestDate  DateTime?
  status               PlantingStatus @default(PLANNED)
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  farm                 Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropType             CropType       @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  field                GrowField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  treatments           CropTreatment[]
  harvests             Harvest[]
  farmTasks            FarmTask[]

  @@index([farmId])
  @@index([cropTypeId])
  @@index([fieldId])
  @@index([farmId, status])
}

enum TreatmentType {
  IRRIGATION
  FERTILIZER
  PESTICIDE
  HERBICIDE
  OTHER
}

model CropTreatment {
  id          String        @id @default(uuid())
  plantingId  String
  type        TreatmentType @default(OTHER)
  appliedDate DateTime      @default(now())
  productName String?
  quantity    Float?
  unit        String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  planting    Planting      @relation(fields: [plantingId], references: [id], onDelete: Cascade)

  @@index([plantingId])
}

model Harvest {
  id            String   @id @default(uuid())
  plantingId    String
  harvestDate   DateTime @default(now())
  quantity      Float
  unit          String   @default("kg")
  qualityGrade  String?
  lossQuantity  Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planting      Planting @relation(fields: [plantingId], references: [id], onDelete: Cascade)

  @@index([plantingId])
  @@index([harvestDate])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  MISSED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCategory {
  LIVESTOCK
  CROPS
  MAINTENANCE
  ADMIN
  OTHER
}

model FarmTask {
  id              String       @id @default(uuid())
  farmId          String
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  category        TaskCategory @default(OTHER)
  color           String?
  dueDate         DateTime?
  scheduledDate   DateTime?
  completedAt     DateTime?
  hoursSpent      Float?
  assigneeUserId  String?
  fieldId         String?
  plantingId      String?
  cattleId        String?
  livestockId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  farm            Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  assignee        User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  field           GrowField?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  planting        Planting?    @relation(fields: [plantingId], references: [id], onDelete: SetNull)
  cattle          Cattle?      @relation(fields: [cattleId], references: [id], onDelete: SetNull)
  livestock       Livestock?   @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  checklist       TaskChecklistItem[]

  @@index([farmId])
  @@index([farmId, status])
  @@index([farmId, dueDate])
  @@index([assigneeUserId])
}

model TaskChecklistItem {
  id             String   @id @default(uuid())
  taskId         String
  label          String
  done           Boolean  @default(false)
  assigneeUserId String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task           FarmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
